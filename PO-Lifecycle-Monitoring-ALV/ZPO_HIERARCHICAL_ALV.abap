REPORT ZSDR_HEIRARCHICAL.
TABLES EKKO.

SELECT-OPTIONS S_EBELN FOR EKKO-EBELN.

TYPES: BEGIN OF TY_EKKO,
         EBELN  TYPE EKKO-EBELN,
         BUKRS  TYPE EKKO-BUKRS,
         LPONR  TYPE EKKO-LPONR,
         ICON   TYPE ICON_D,
         EXPAND,
       END OF TY_EKKO.

TYPES: BEGIN OF TY_EKPO,
         EBELN TYPE EKPO-EBELN,
         EBELP TYPE EKPO-EBELP,
       END OF TY_EKPO.

DATA: IT_EKKO TYPE TABLE OF TY_EKKO,
      IT_EKPO TYPE TABLE OF TY_EKPO,
      WA_EKKO TYPE TY_EKKO,
      WA_EKPO TYPE TY_EKPO.

DATA IT_FIELDCAT TYPE SLIS_T_FIELDCAT_ALV.
DATA WA_FIELDCAT TYPE SLIS_FIELDCAT_ALV.

DATA IT_LAYOUT TYPE SLIS_LAYOUT_ALV.
DATA WA_KEYINFO TYPE SLIS_KEYINFO_ALV.



SELECT EBELN BUKRS LPONR FROM EKKO INTO TABLE IT_EKKO WHERE EBELN IN S_EBELN.

IF IT_EKKO IS NOT INITIAL.
  SELECT EBELN EBELP FROM EKPO INTO TABLE IT_EKPO FOR ALL ENTRIES IN IT_EKKO
  WHERE EBELN = IT_EKKO-EBELN.

ENDIF.
*// fieldcat fill
wa_fieldcat-tabname = 'IT_EKKO'.
WA_FIELDCAT-COL_POS = '1'.
WA_FIELDCAT-FIELDNAME = 'EBELN'.
WA_FIELDCAT-SELTEXT_M = 'PO NUMBER'.
WA_FIELDCAT-OUTPUTLEN = 20.
WA_FIELDCAT-KEY = 'x'.
APPEND WA_FIELDCAT TO IT_FIELDCAT.
CLEAR WA_FIELDCAT.

wa_fieldcat-tabname = 'IT_EKKO'.
WA_FIELDCAT-COL_POS = '2'.
WA_FIELDCAT-FIELDNAME = 'BUKRS'.
WA_FIELDCAT-SELTEXT_M = 'COMAPNY CODE'.
WA_FIELDCAT-OUTPUTLEN = 20.
WA_FIELDCAT-KEY = 'x'.
APPEND WA_FIELDCAT TO IT_FIELDCAT.
CLEAR WA_FIELDCAT.


wa_fieldcat-tabname = 'IT_EKKO'.
WA_FIELDCAT-COL_POS = '3'.
WA_FIELDCAT-FIELDNAME = 'LPONR'.
WA_FIELDCAT-SELTEXT_M = 'LAST ITEAM NUMBER'.
WA_FIELDCAT-OUTPUTLEN = 20.
WA_FIELDCAT-KEY = 'x'.
APPEND WA_FIELDCAT TO IT_FIELDCAT.
CLEAR WA_FIELDCAT.

wa_fieldcat-tabname = 'IT_EKPO'.
WA_FIELDCAT-COL_POS = '4'.
WA_FIELDCAT-FIELDNAME = 'ebeln'.
WA_FIELDCAT-SELTEXT_M = 'purchase document number'.
WA_FIELDCAT-OUTPUTLEN = 20.
WA_FIELDCAT-KEY = 'x'.
APPEND WA_FIELDCAT TO IT_FIELDCAT.
CLEAR WA_FIELDCAT.


wa_fieldcat-tabname = 'IT_EKPO'.
WA_FIELDCAT-COL_POS = '5'.
WA_FIELDCAT-FIELDNAME = 'ebelp'.
WA_FIELDCAT-SELTEXT_M = 'iteam number po number'.
WA_FIELDCAT-OUTPUTLEN = 20.
WA_FIELDCAT-KEY = 'x'.
APPEND WA_FIELDCAT TO IT_FIELDCAT.
CLEAR WA_FIELDCAT.

*\\ FILLING FIELD LAYOUT AND KEY TO DISPLAY ITEAM UNDER HEADER DATA

IT_LAYOUT-EXPAND_FIELDNAME = 'EXPAND'.
IT_LAYOUT-WINDOW_TITLEBAR = 'HIRARICHAL ALV REPORT'.
IT_LAYOUT-LIGHTS_TABNAME = 'IT_EKPO'.
IT_LAYOUT-COLWIDTH_OPTIMIZE = 'x'.

WA_KEYINFO-HEADER01 = 'EBELN'.
WA_KEYINFO-ITEM01 = 'EBELN'.

CALL FUNCTION 'REUSE_ALV_HIERSEQ_LIST_DISPLAY'
  EXPORTING

    I_CALLBACK_PROGRAM = SY-CPROG

    IS_LAYOUT          = IT_LAYOUT
    IT_FIELDCAT        = IT_FIELDCAT

    I_TABNAME_HEADER   = 'IT_EKKO'
    I_TABNAME_ITEM     = 'IT_EKPO'

    IS_KEYINFO         = WA_KEYINFO

  TABLES
    T_OUTTAB_HEADER    = IT_EKKO
    T_OUTTAB_ITEM      = IT_EKPO.