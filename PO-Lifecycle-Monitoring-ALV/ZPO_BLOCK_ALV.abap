REPORT ZPO_BLOCK_ALV.
TYPE-POOLS: SLIS.
TABLES: EKKO , LFA1,EKPO.

SELECT-OPTIONS S_EBELN FOR EKKO-EBELN.
* Structure 1 - Purchase Order Header
TYPES: BEGIN OF TY_EKKO,
         EBELN TYPE EKKO-EBELN,
         LIFNR TYPE EKKO-LIFNR,
         BEDAT TYPE EKKO-BEDAT,
       END OF TY_EKKO.


* Structure 2 - Vendor Details
TYPES: BEGIN OF TY_LFA1,
         LIFNR TYPE LFA1-LIFNR,
         NAME1 TYPE LFA1-NAME1,
       END OF TY_LFA1.


* Structure 3 - Purchase Order Items
TYPES: BEGIN OF TY_EKPO,
         EBELN TYPE EKPO-EBELN,
         EBELP TYPE EKPO-EBELP,
         MATNR TYPE EKPO-MATNR,
         MENGE TYPE EKPO-MENGE,
         NETPR TYPE EKPO-NETPR,
       END OF TY_EKPO.


DATA: IT_EKKO TYPE TABLE OF TY_EKKO,
      IT_LFA1 TYPE TABLE OF TY_LFA1,
      IT_EKPO TYPE TABLE OF TY_EKPO,
      WA_EKKO TYPE TY_EKKO,
      WA_EKPO TYPE TY_EKPO,
      WA_LFA1 TYPE TY_LFA1.

DATA:IT_FCAT1 TYPE SLIS_T_FIELDCAT_ALV,
     IT_FCAT2 TYPE SLIS_T_FIELDCAT_ALV,
     IT_FCAT3 TYPE SLIS_T_FIELDCAT_ALV.
DATA: WA_FCAT TYPE SLIS_FIELDCAT_ALV.

DATA:IT_LAYOUT TYPE SLIS_LAYOUT_ALV,
     A_REPID   TYPE SY-REPID.
DATA: IT_EVENTS TYPE SLIS_T_EVENT,
      WA_EVENT  TYPE SLIS_ALV_EVENT.
* Fetch Vendor Details

START-OF-SELECTION.

* Fetch Purchase Order Header
  SELECT EBELN
         LIFNR
         BEDAT
    FROM EKKO
    INTO TABLE IT_EKKO
    WHERE EBELN IN S_EBELN.

  IF IT_EKKO IS INITIAL.
    MESSAGE 'No purchase orders found' TYPE 'I'.
    RETURN.
  ENDIF.

* Fetch Vendor Details
  SELECT LIFNR
         NAME1
    FROM LFA1
    INTO TABLE IT_LFA1
    FOR ALL ENTRIES IN IT_EKKO
    WHERE LIFNR = IT_EKKO-LIFNR.

* Fetch Purchase Order Items
  SELECT EBELN
         EBELP
         MATNR
         MENGE
         NETPR
    FROM EKPO
    INTO TABLE IT_EKPO
    FOR ALL ENTRIES IN IT_EKKO
    WHERE EBELN = IT_EKKO-EBELN.

*    BLOCK 1 - Header Field Catalog

  WA_FCAT-TABNAME = 'EKKO'.
  WA_FCAT-FIELDNAME = 'EBELN'.
  WA_FCAT-SELTEXT_M = 'Purchase Order'.
  WA_FCAT-COL_POS = 1.
  WA_FCAT-EMPHASIZE = 'C410'.
  APPEND WA_FCAT TO IT_FCAT1.
  CLEAR WA_FCAT.

  WA_FCAT-TABNAME = 'EKKO'.
  WA_FCAT-FIELDNAME = 'BEDAT'.
  WA_FCAT-SELTEXT_M = 'Document Date'.
  WA_FCAT-COL_POS = 3.
  APPEND WA_FCAT TO IT_FCAT1.
  CLEAR WA_FCAT.

  WA_FCAT-TABNAME = 'EKKO'.
  WA_FCAT-FIELDNAME = 'LIFNR'.
  WA_FCAT-SELTEXT_M = 'Vendor Number'.
  WA_FCAT-COL_POS = 4.
  APPEND WA_FCAT TO IT_FCAT1.
  CLEAR WA_FCAT.

*  BLOCK 2 - Vendor Field Catalog
  WA_FCAT-TABNAME = 'LFA1'.
  WA_FCAT-FIELDNAME = 'LIFNR'.
  WA_FCAT-SELTEXT_M = 'Vendor Number'.
  WA_FCAT-COL_POS = 1.
  APPEND WA_FCAT TO IT_FCAT2.
  CLEAR WA_FCAT.

  WA_FCAT-TABNAME = 'LFA1'.
  WA_FCAT-FIELDNAME = 'NAME1'.
  WA_FCAT-SELTEXT_M = 'Vendor Name'.
  WA_FCAT-COL_POS = 2.
  WA_FCAT-EMPHASIZE = 'C310'.
  APPEND WA_FCAT TO IT_FCAT2.
  CLEAR WA_FCAT.

*   BLOCK 3 - Item Field Catalog


  WA_FCAT-TABNAME = 'EKPO'.
  WA_FCAT-FIELDNAME = 'EBELN'.
  WA_FCAT-SELTEXT_M = 'Purchase Order'.
  WA_FCAT-COL_POS = 1.
  APPEND WA_FCAT TO IT_FCAT3.
  CLEAR WA_FCAT.

  WA_FCAT-TABNAME = 'EKPO'.
  WA_FCAT-FIELDNAME = 'EBELP'.
  WA_FCAT-SELTEXT_M = 'Item Number'.
  WA_FCAT-COL_POS = 2.
  APPEND WA_FCAT TO IT_FCAT3.
  CLEAR WA_FCAT.


  WA_FCAT-TABNAME = 'EKPO'.
  WA_FCAT-FIELDNAME = 'MATNR'.
  WA_FCAT-SELTEXT_M = 'Material'.
  WA_FCAT-COL_POS = 3.
  WA_FCAT-EMPHASIZE = 'C310'.
  APPEND WA_FCAT TO IT_FCAT3.
  CLEAR WA_FCAT.


  WA_FCAT-TABNAME = 'EKPO'.
  WA_FCAT-FIELDNAME = 'MENGE'.
  WA_FCAT-SELTEXT_M = 'Quantity'.
  WA_FCAT-COL_POS = 4.
  APPEND WA_FCAT TO IT_FCAT3.
  CLEAR WA_FCAT.

  WA_FCAT-TABNAME = 'EKPO'.
  WA_FCAT-FIELDNAME = 'NETPR'.
  WA_FCAT-SELTEXT_M = 'Net Price'.
  WA_FCAT-COL_POS = 5.
  APPEND WA_FCAT TO IT_FCAT3.
  CLEAR WA_FCAT.




*    Initialize Block ALV
  CALL FUNCTION 'REUSE_ALV_BLOCK_LIST_INIT'
    EXPORTING
      I_CALLBACK_PROGRAM = A_REPID
*     I_CALLBACK_PF_STATUS_SET       = ' '
*     I_CALLBACK_USER_COMMAND        = ' '
*     IT_EXCLUDING       =
    .
  CALL FUNCTION 'REUSE_ALV_BLOCK_LIST_APPEND'
    EXPORTING
      IS_LAYOUT   = IT_LAYOUT
      IT_FIELDCAT = IT_FCAT1
      I_TABNAME   = 'EKKO'
      IT_EVENTS   = IT_EVENTS
    TABLES
      T_OUTTAB    = IT_EKKO.

  CALL FUNCTION 'REUSE_ALV_BLOCK_LIST_APPEND'
    EXPORTING
      IS_LAYOUT   = IT_LAYOUT
      IT_FIELDCAT = IT_FCAT2
      I_TABNAME   = 'LFA1'
      IT_EVENTS   = IT_EVENTS
    TABLES
      T_OUTTAB    = IT_LFA1.


  CALL FUNCTION 'REUSE_ALV_BLOCK_LIST_APPEND'
    EXPORTING
      IS_LAYOUT   = IT_LAYOUT
      IT_FIELDCAT = IT_FCAT3
      I_TABNAME   = 'EKPO'
      IT_EVENTS   = IT_EVENTS
    TABLES
      T_OUTTAB    = IT_EKPO.

  CALL FUNCTION 'REUSE_ALV_BLOCK_LIST_DISPLAY'
*   EXPORTING
*     I_INTERFACE_CHECK             = ' '
*     IS_PRINT                      =
*     I_SCREEN_START_COLUMN         = 0
*     I_SCREEN_START_LINE           = 0
*     I_SCREEN_END_COLUMN           = 0
*     I_SCREEN_END_LINE             = 0
*   IMPORTING
*     E_EXIT_CAUSED_BY_CALLER       =
*     ES_EXIT_CAUSED_BY_USER        =
*   EXCEPTIONS
*     PROGRAM_ERROR                 = 1
*     OTHERS                        = 2
    .
  IF SY-SUBRC <> 0.
* Implement suitable error handling here
  ENDIF.